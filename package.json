{
  "name": "love-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test:ludo": "tsx --test tests/ludo-visuals.test.ts tests/ludo-solo.test.ts tests/ludo-senegal.test.ts",
    "test:watch": "tsx --test tests/watch-together.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/privacy-screen": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "@capacitor/cli": "^8.6.2",
    "tsx": "^4.20.6"
  }
}
