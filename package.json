{
  "name": "love-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "test:ludo": "tsx --test tests/ludo-visuals.test.ts tests/ludo-solo.test.ts tests/ludo-senegal.test.ts tests/rps.test.ts tests/couple-party.test.ts",
    "test:rps": "tsx --test tests/rps.test.ts tests/couple-party.test.ts",
    "test:watch": "tsx --test tests/watch-together.test.ts tests/watch-notify.test.ts",
    "test:privacy": "tsx --test tests/privacy-overlay.test.ts",
    "test:puzzle": "tsx --test tests/puzzle.test.ts",
    "test:call": "tsx --test tests/voice-call.test.ts",
    "test:background-call": "tsx --test tests/native-background-call.test.ts",
    "test:e2ee": "tsx --test tests/e2ee.test.ts",
    "test:server": "tsx --test tests/server-diagnostics.test.ts",
    "test:server-scale": "node scripts/server-sql-scale-check.mjs",
    "test:reconcile": "tsx --test tests/reconcile.test.ts",
    "test:design": "tsx --test tests/redesign.test.ts",
    "test:chat": "tsx --test tests/chat-stability.test.ts tests/multi-couple.test.ts tests/chat-composer-signature.test.ts",
    "test:chat-type-push": "tsx --test tests/chat-type-push-avatar.test.ts",
    "test:expressions": "tsx --test tests/expressions.test.ts",
    "test:activity": "tsx --test tests/activity-icons.test.ts",
    "test:animation": "tsx --test tests/activity-frames.test.ts",
    "test:replies": "tsx --test tests/message-replies.test.ts",
    "test:voice-ui": "tsx --test tests/voice-ui.test.ts",
    "test:voice-sequence": "tsx --test tests/voice-sequence.test.ts",
    "test:audio-focus": "tsx --test tests/audio-focus-profile-usability.test.ts",
    "test:voice-polish": "tsx --test tests/launch-voice-polish.test.ts",
    "test:voice-outbox": "tsx --test tests/voice-outbox.test.ts",
    "test:photos": "tsx --test tests/photo-reliability.test.ts tests/profile-photo.test.ts",
    "test:reliability": "tsx --test tests/reliability-audit.test.ts",
    "test:session-recovery": "tsx --test tests/restore-session-mobile-error.test.ts",
    "test:partner-recovery": "tsx --test tests/partner-recovery.test.ts",
    "test:security": "tsx --test tests/security-release.test.ts",
    "test:deletion": "tsx --test tests/room-deletion.test.ts",
    "test:load": "node scripts/staging-load.mjs --synthetic",
    "load:staging": "node scripts/staging-load.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/privacy-screen": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "@capacitor/cli": "^8.6.2",
    "tsx": "^4.20.6"
  }
}
